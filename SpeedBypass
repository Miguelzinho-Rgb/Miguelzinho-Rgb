-- ====================================================================
-- LÓGICA DO CORRER E FUNCIONALIDADES
-- ====================================================================

local function ativarCorrida()
	if not CORRENDO and humanoid then
		CORRENDO = true
		humanoid.WalkSpeed = VELOCIDADE_CORRER
		
		-- Animação realista da UI expandindo a barra de energia ativa
		TweenService:Create(BarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(220, 60, 60)}):Play()
		TweenService:Create(KeyLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Color3.fromRGB(255, 60, 60)}):Play()
	end
end

local function desativarCorrida()
	if CORRENDO and humanoid then
		CORRENDO = false
		humanoid.WalkSpeed = VELOCIDADE_NORMAL
		
		-- Retorna a UI ao estado normal
		TweenService:Create(BarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(180, 50, 50)}):Play()
		TweenService:Create(KeyLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
	end
end

-- Detecção do Teclado (Tecla R)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.R then
		ativarCorrida()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.R then
		desativarCorrida()
	end
end)

-- Lógica para Tornar o Slider da Barra Arrastável Manualmente com o Mouse/Toque
local arrastando = false

SliderButton.MouseButton1Down:Connect(function()
	arrastando = true
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		arrastando = false
	end
end)

RunService.RenderStepped:Connect(function()
	if arrastando then
		local mousePos = UserInputService:GetMouseLocation()
		local barGlobalPos = BarBackground.AbsolutePosition
		local barWidth = BarBackground.AbsoluteSize.X
		
		-- Calcula a posição relativa do clique dentro da barra
		local xRelativo = mousePos.X - barGlobalPos.X
		local porcentagem = math.clamp(xRelativo / barWidth, 0, 1)
		
		-- Atualiza a posição visual do Slider
		SliderButton.Position = UDim2.new(porcentagem, -10, 0.5, -12)
		
		-- Como a corrida é infinita, movimentar o slider simula alteração estética de intensidade visual
		if porcentagem > 0.1 then
			ativarCorrida()
		else
			desativarCorrida()
		end
	elseif CORRENDO then
		-- Se estiver correndo pela tecla, o slider acompanha o preenchimento de forma automática e infinita
		SliderButton.Position = UDim2.new(1, -10, 0.5, -12)
	else
		-- Volta para a origem quando parado
		SliderButton.Position = UDim2.new(0, -10, 0.5, -12)
	end
end)
